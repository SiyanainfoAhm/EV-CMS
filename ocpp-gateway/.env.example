PORT=4040
NODE_ENV=development

# OCPP WebSocket path: ws://host:PORT/ocpp/<CHARGE_POINT_ID>
OCPP_WS_PATH=/ocpp
OCPP_CALL_TIMEOUT_MS=30000
OCPP_HEARTBEAT_INTERVAL_SEC=300

# Supabase (service role — never expose to clients; copy to .env only)
SUPABASE_URL=https://fvveqziyusjgqejowkfp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TEMP testing only — accept any idTag on Authorize/StartTransaction (never in production)
# OCPP_BYPASS_RFID_AUTH=true

# TLS certs for production WSS (optional in dev)
# TLS_CERT_PATH=
# TLS_KEY_PATH=
