PORT=4040
NODE_ENV=development

# OCPP WebSocket (chargers connect here)
OCPP_WS_PORT=4041
OCPP_WS_PATH=/ocpp

# Supabase (service role for server-side writes — never expose to clients)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# TLS certs for production WSS (optional in dev)
# TLS_CERT_PATH=
# TLS_KEY_PATH=
