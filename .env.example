VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ2dmVxeml5dXNqZ3Flam93a2ZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MTU5MzY5MDUsImV4cCI6MjAzMTUxMjkwNX0.71R7B0aqK7MvAppN-Bytj56VvKPeUFRGRyjKbZH0BBw

# OCPP gateway REST API — public URL of your ocpp-gateway server (NOT Vercel; deploy gateway on VPS/Railway/Docker)
# Local: http://localhost:4040  →  ws://localhost:4040/ocpp/{chargePointId}
# Vercel: set this in Project → Settings → Environment Variables, then redeploy
VITE_OCPP_GATEWAY_API_URL=https://ev-cms-ocpp-dfccil.fly.dev
# Optional; default /ocpp → ws://host:4040/ocpp/{chargePointId}
VITE_OCPP_WS_PATH=/ocpp

# Payment gateway (Phase 3) — leave empty to use UAT mock in admin Payments page
VITE_PAYMENT_GATEWAY_URL=
# Force mock on/off: true | false (default: mock when URL empty)
VITE_PAYMENT_GATEWAY_MOCK=

# Simulation: set true to show simulator UI + auto ticks (off by default)
VITE_ENABLE_SIMULATION=false

# Power Automate — HTTP POST URL from flow trigger "When an HTTP request is received"
# Used by login page "Test email" button (proxied via /api/power-automate/test-email)
# Local dev: POWER_AUTOMATE_EMAIL_URL or VITE_POWER_AUTOMATE_EMAIL_URL
# Vercel: set POWER_AUTOMATE_EMAIL_URL only (server-side, not VITE_)
# Wrap in quotes — URL contains & query parameters
#
# In the flow, "Send an email (V2)" action:
#   To = to | Subject = subject | Body = body (or bodyHtml) | Is HTML = Yes
POWER_AUTOMATE_EMAIL_URL=""

# Optional comma-separated extra recipients for unauthorized login alerts (in addition to Super Admins)
VITE_SECURITY_ALERT_EMAIL=

# Firebase — DFCCIL EV CMS Web Admin (project: dffcilevcms)
# From Firebase Console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dffcilevcms.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dffcilevcms
VITE_FIREBASE_STORAGE_BUCKET=dffcilevcms.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional — for browser push (FCM Web Push certificate key pair)
VITE_FIREBASE_VAPID_KEY=
