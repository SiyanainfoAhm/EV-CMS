# OCPP gateway REST API — public URL of your ocpp-gateway server (NOT Vercel; deploy gateway on VPS/Railway/Docker)
# Local: http://localhost:4040  →  ws://localhost:4040/ocpp/{chargePointId}
# Vercel: set this in Project → Settings → Environment Variables, then redeploy
VITE_OCPP_GATEWAY_API_URL=http://localhost:4040
# Optional; default /ocpp → ws://host:4040/ocpp/{chargePointId}
VITE_OCPP_WS_PATH=/ocpp

# Payment gateway (Phase 3) — leave empty to use UAT mock in admin Payments page
VITE_PAYMENT_GATEWAY_URL=
# Force mock on/off: true | false (default: mock when URL empty)
VITE_PAYMENT_GATEWAY_MOCK=

# Simulation: true = show simulator UI + auto ticks (dev default). Production builds ignore unless set to true.
VITE_ENABLE_SIMULATION=true
