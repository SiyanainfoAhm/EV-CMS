# Backend only. Configure in hosting environment; never EXPO_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a cryptographically random secret of at least 32 bytes.
SSO_SESSION_SECRET=
SSO_ALLOWED_REDIRECT_URIS=in.dfccil.evcms://auth/callback
# Confirmed by DFCCIL: public mobile client, PKCE S256, no secret.
SSO_TOKEN_AUTH_METHOD=none
# Required only for confidential client methods.
SSO_CLIENT_SECRET=
# Optional provider logout; enable only after its callback is approved.
SSO_POST_LOGOUT_REDIRECT_URI=
# Protected server-to-server charging gateway. Deploy deployment/ocpp-auth.js first.
OCPP_GATEWAY_API_URL=https://ev-cms-ocpp-dfccil.fly.dev
OCPP_GATEWAY_API_KEY=
