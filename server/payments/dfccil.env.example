# Server-only configuration. Enabling allows user-triggered REAL payments; no UAT exists.
# Keep false until migration, public return deployment and controlled live-test approval.
DFCCIL_PAYMENTS_ENABLED=false
DFCCIL_PAYMENT_BASE_URL=https://epay.dfccil.com
DFCCIL_PAYMENT_APP_ID=EV001
DFCCIL_NATURE_OF_PAYMENT_ID=30
DFCCIL_PAYMENT_RETURN_URL=https://ev-cms-rho.vercel.app/api/payments/dfccil/return
# No client secret is required by the supplied payment guide.
# Status API verification is implemented; unsigned returns never mark bills paid.
