{
  "expo": {
    "name": "DFCCIL EV CMS",
    "slug": "ev-cms-mobile",
    "owner": "siyanainfos-team",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.dfccil.evcms",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan charger QR codes.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to upload your profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.dfccil.evcms",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DFCCIL EV CMS to access your photos for profile pictures."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0dee4cea-d793-45c3-89b7-37c62445324b"
      }
    }
  }
}
