# Copy to .env — use the same Supabase project as the web CMS (anon key only; never service role).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_OCPP_GATEWAY_API_URL=http://localhost:4040
EXPO_PUBLIC_PAYMENT_GATEWAY_URL=

# Simulation badge in app (off in production builds unless true)
EXPO_PUBLIC_ENABLE_SIMULATION=true
