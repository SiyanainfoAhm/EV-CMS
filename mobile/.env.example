# Copy to .env — use the same Supabase project as the web CMS (anon key only; never service role).
# Enable after backend deployment, database mapping, callback registration and native rebuild.
EXPO_PUBLIC_SSO_ENABLED=false
EXPO_PUBLIC_SSO_REDIRECT_URI=in.dfccil.evcms://auth/callback
EXPO_PUBLIC_SSO_BACKEND_URL=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_OCPP_GATEWAY_API_URL=https://ev-cms-ocpp-dfccil.fly.dev
EXPO_PUBLIC_PAYMENT_GATEWAY_URL=

# Simulation badge in app (off by default; set true to enable)
EXPO_PUBLIC_ENABLE_SIMULATION=false

# Emulator / QA debug: runs payment then charging; skips cable-plug UI gate (never in production)
EXPO_PUBLIC_ENABLE_CHARGING_DEBUG=false

# Prepaid session payment
# true = payment before charging; false = start charging directly (pay at station)
EXPO_PUBLIC_PAYMENT_GATEWAY_ENABLED=true
EXPO_PUBLIC_PAYMENT_GATEWAY_NAME=razorpay
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
EXPO_PUBLIC_RAZORPAY_THEME_COLOR=#0B5FFF
# Force mock payment. Debug mode auto-mocks when Razorpay native SDK is unavailable (Expo Go / emulator).
EXPO_PUBLIC_ENABLE_PAYMENT_MOCK=false

# Displays post-session DFCCIL checkout. Server must separately enable live orders.
EXPO_PUBLIC_DFCCIL_PAYMENTS_ENABLED=false
